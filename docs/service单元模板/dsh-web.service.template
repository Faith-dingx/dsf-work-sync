[Unit]
Description=DeepSeek Harness Web UI (port 3080)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStartPre=/bin/bash -lc 'cd {{HARNESS_DIR}} && CI=true pnpm install --no-frozen-lockfile'
ExecStart=/bin/bash -lc 'cd {{HARNESS_DIR}} && {{HOME}}/.hermes/node/bin/pnpm dsh web --host 0.0.0.0 --port 3080 --no-open --trusted-host {{TRUSTED_HOSTS}}'
WorkingDirectory={{HARNESS_DIR}}
Environment="PATH={{HOME}}/.hermes/node/bin:{{HOME}}/.local/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"
Environment="HOME={{HOME}}"
Environment="CI=true"
Restart=on-failure
RestartSec=5
TimeoutStartSec=120
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=default.target