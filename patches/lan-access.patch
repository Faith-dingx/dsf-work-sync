Author: dingx <dingx@dingx-ubuntu.tail77cc7a.ts.net>
Date:   Tue Aug 18 14:17:26 2026 +0800

    feat(web): support serving the Web UI over LAN/remote reach
    
    Allow dsh web to bind 0.0.0.0 (or any address) and serve remote clients by
    opening the privileged API plane to explicitly trusted non-loopback hosts.
    
    - startup: drop the hard block on --host 0.0.0.0; any bind address is now
      accepted at the caller's discretion.
    - host-webserver: widen the listen host config from the two loopback constants
      to any string bind address.
    - client-connection: the privileged-method fence now accepts the deployment's
      trustedHosts instead of an empty list, so a LAN/remote deployment that
      declares --trusted-host authorities can drive settings, credentials, and
      other privileged methods from those hosts; default (no trusted hosts)
      behaviour stays loopback-same-origin.
    - web main: polyfill crypto.randomUUID for insecure (non-HTTPS) origins so the
      workspace/settings UI works when reached over http://<LAN-IP>:3080.
    
    Verified with build:lib:host and typecheck:contracts-ready (both clean).

diff --git a/apps/web/src/main.ts b/apps/web/src/main.ts
index feb85db15a..c2b98aa39d 100644
--- a/apps/web/src/main.ts
+++ b/apps/web/src/main.ts
@@ -3,6 +3,38 @@
  * loader holding, module-table seeding, AppRoot gate, plugin assembly — lives
  * in @deepseek-ai/dsh-client-web; this file only finds the mount point.
  */
+
+// Polyfill crypto.randomUUID for insecure origins (non-HTTPS / non-localhost
+// access, e.g. http://<LAN-IP>:3080). In insecure contexts the Web Crypto
+// `randomUUID` is unavailable, which broke workspace/settings UI. Backfill it
+// with a RFC 4122 v4 UUID built from crypto.getRandomValues, which browsers
+// do expose on insecure origins.
+if (typeof globalThis.crypto?.randomUUID !== 'function') {
+  const cryptoObj: Crypto | undefined = globalThis.crypto
+  const uuid = (): `${string}-${string}-${string}-${string}-${string}` => {
+    const raw = new Uint8Array(16)
+    // crypto.getRandomValues is available on insecure origins; fall back to
+    // Math.random-derived filler only if even that is absent.
+    const grv = globalThis.crypto?.getRandomValues
+    if (grv) {
+      grv.call(globalThis.crypto, raw)
+    } else {
+      for (let i = 0; i < 16; i++) raw[i] = Math.floor(Math.random() * 256)
+    }
+    const b6 = raw[6] ?? 0
+    const b8 = raw[8] ?? 0
+    raw[6] = (b6 & 0x0f) | 0x40
+    raw[8] = (b8 & 0x3f) | 0x80
+    const hex = Array.from(raw, b => b.toString(16).padStart(2, '0'))
+    return `${hex.slice(0, 4).join('')}-${hex.slice(4, 6).join('')}-${hex.slice(6, 8).join('')}-${hex.slice(8, 10).join('')}-${hex.slice(10).join('')}`
+  }
+  if (cryptoObj) {
+    cryptoObj.randomUUID = uuid
+  } else {
+    ;(globalThis as Record<string, unknown>).crypto = { randomUUID: uuid }
+  }
+}
+
