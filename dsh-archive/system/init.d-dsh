#!/bin/sh /etc/rc.common
# dsh — DeepSeek Harness web 服务 (0.1.5-rc.2 官网npm全新安装 2026-09-23)
# 架构: 0.1.5 web 只绑 127.0.0.1(新版安全限制), LAN 访问经 iptables DNAT 10.10.10.2:3080->127.0.0.1:3080
# key 唯一来源: boxinfo.db keys表(env:* 键经 keypool-env.sh 注入); dsh.env 不存任何 key
# 中枢对接: DSH_HUB_SESSION_TOKEN 与 hubv2 data/hub-token 同值
# 端口: 3080=dsh web | 3083=config-ui(独立init.d)

START=95
STOP=10
USE_PROCD=1

PKG_DIR=/mnt/agent/dsh/app/node_modules/@deepseek-ai/dsh
NODE_BIN=/mnt/agent/dsh/node/bin/node
DSH_HOME=/srv/dsh/home
DSH_PORT=3080
LAN_IP=$(uci get network.lan.ipaddr 2>/dev/null || echo 10.10.10.2)
DSH_LOG=/var/log/dsh.log
DSH_ENV_FILE=/srv/dsh/home/dsh.env

export DSH_HUB_SESSION_TOKEN="<HUB_TOKEN — 从中枢 hubv2 data/hub-token 取同值>"

load_key_env() {
    [ -r "$DSH_ENV_FILE" ] && . "$DSH_ENV_FILE" 2>/dev/null || :
    KPE=$(/bin/sh /mnt/agent/work/bin/keypool-env.sh 2>/dev/null) || KPE=""
    [ -n "$KPE" ] && eval "$KPE"
}

wait_for_hermes_mount() {
    local i=0
    while [ $i -lt 30 ]; do
        [ -x /mnt/agent/dsh/node/bin/node ] && return 0
        sleep 2; i=$((i+1))
    done
    return 1
}

start_service() {
    wait_for_hermes_mount || {
        echo "dsh: /mnt/agent 未挂载, 放弃启动" >&2
        return 1
    }
    load_key_env
    procd_open_instance
    procd_set_param command /bin/sh -c "cd $PKG_DIR && exec $NODE_BIN --expose-internals lib/bin.js web --port $DSH_PORT --trusted-host $LAN_IP:3080 --no-open >> $DSH_LOG 2>&1"
    procd_set_param cwd "$PKG_DIR"
    procd_set_param pidfile /var/run/dsh.pid
    procd_set_param respawn 3600 5 0
    # [20260923] retry 0=无限重试: 开机时/mnt/agent(extroot)晚挂载导致node路径暂缺,
    # 有限重试(5次)会把DSH打死在开机窗口 — 必须无限等挂载。
    procd_set_param env DSH_HOME="$DSH_HOME" DSH_HUB_SESSION_TOKEN="$DSH_HUB_SESSION_TOKEN" AGNES_API_KEY="$AGNES_API_KEY" AGNES_PLAN_API_KEY="$AGNES_PLAN_API_KEY" OPENCODE_GO_API_KEY="$OPENCODE_GO_API_KEY" OPENCODE_GO2_API_KEY="$OPENCODE_GO2_API_KEY" ZHIPU_API_KEY="$ZHIPU_API_KEY" GONGJI_API_KEY="$GONGJI_API_KEY" HUOSHAN_CODE_API_KEY="$HUOSHAN_CODE_API_KEY" ROUTER_9888_API_KEY="$ROUTER_9888_API_KEY" AGNES_CN_API_KEY="$AGNES_CN_API_KEY" BENDI_TC_API_KEY="$BENDI_TC_API_KEY" DEEPSEEK_API_KEY="$DEEPSEEK_API_KEY" TAVILY_API_KEY="$TAVILY_API_KEY" DSH_TRUSTED_HOSTS="$DSH_TRUSTED_HOSTS"
    procd_close_instance
}

# 开机补 DNAT 转发(防火墙重启也会丢, 由 boot 段保证)
boot() {
    sysctl -w net.ipv4.conf.all.route_localnet=1 >/dev/null
    iptables -t nat -C PREROUTING -d $LAN_IP -p tcp --dport 3080 -j DNAT --to-destination 127.0.0.1:3080 2>/dev/null || \
    iptables -t nat -A PREROUTING -d $LAN_IP -p tcp --dport 3080 -j DNAT --to-destination 127.0.0.1:3080
    iptables -t nat -C OUTPUT -d $LAN_IP -p tcp --dport 3080 -j DNAT --to-destination 127.0.0.1:3080 2>/dev/null || \
    iptables -t nat -A OUTPUT -d $LAN_IP -p tcp --dport 3080 -j DNAT --to-destination 127.0.0.1:3080
}
