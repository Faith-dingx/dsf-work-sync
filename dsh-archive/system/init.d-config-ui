#!/bin/sh /etc/rc.common
# config-ui — DSH 扩展配置界面（3083；密钥/模型服务/子代理管理/分类器模型）
# 启动环境集中在 start.sh（HOST=0.0.0.0 / JS_YAML_PATH 等——均为 2026-09-10 实测教训）

START=99
STOP=10
USE_PROCD=1

APP_DIR=/mnt/agent/dsh/config-ui
PROG=/bin/sh
APP=$APP_DIR/start.sh

wait_for_node() {
    local i=0
    while [ $i -lt 30 ]; do
        [ -x /srv/dsh/node/bin/node ] && return 0
        sleep 2; i=$((i+1))
    done
    return 1
}


start_service() {
    wait_for_node || {
        echo "config-ui: node 未就绪, 放弃启动" >&2
        return 1
    }

    procd_open_instance
    procd_set_param command "$PROG" "$APP"
    procd_set_param working_directory "$APP_DIR"
    procd_set_param respawn 3600 5 0
    procd_set_param stdout 1
    procd_set_param stderr 1
    procd_close_instance
}
